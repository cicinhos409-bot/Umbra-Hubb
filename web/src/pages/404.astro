---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Página não encontrada | Blog UmbraHub"
  description="O artigo que você procurou não existe ou foi movido."
  noIndex={true}
>
  <Header />

  <main class="max-w-2xl mx-auto px-4 py-32 text-center">
    <p class="text-9xl font-black text-primary opacity-20 mb-2 leading-none">404</p>
    <h1 class="text-3xl font-black text-gray-900 dark:text-white mb-4">Página não encontrada</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-10 text-lg">
      O artigo que você procurou não existe ou foi movido.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/blog"
        class="inline-block bg-primary text-white font-bold px-8 py-3 rounded-xl hover:bg-primary-dark transition-colors"
      >
        Ver todos os artigos →
      </a>
      <a
        href="https://umbrahubb.vercel.app"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white dark:bg-gray-800 text-primary dark:text-primary-light font-bold px-8 py-3 rounded-xl border border-primary dark:border-primary/50 hover:bg-primary-pale dark:hover:bg-gray-700 transition-colors"
      >
        Acessar Dashboard
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
