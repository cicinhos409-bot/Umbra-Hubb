---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{toc.length > 2 && (
  <nav class="mb-8 rounded-xl border border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 p-5">
    <details open>
      <summary class="cursor-pointer select-none list-none flex items-center justify-between mb-0">
        <span class="text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wide">Índice</span>
        <svg class="w-4 h-4 text-gray-400 transition-transform details-arrow" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </summary>
      <ul class="mt-3 space-y-1.5">
        {toc.map(h => (
          <li class={h.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors block py-0.5"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<style>
  details[open] .details-arrow { transform: rotate(180deg); }
</style>
