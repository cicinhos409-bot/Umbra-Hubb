---
interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      image?: string;
      tags?: string[];
      readTime?: string;
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { slug, data } = post;
const formattedDate = data.pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class={`group bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-2xl overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ${featured ? 'md:col-span-2' : ''}`}>
  {data.image && (
    <a href={`/blog/${slug}`}>
      <div class={`bg-gray-100 dark:bg-gray-700 overflow-hidden ${featured ? 'aspect-video' : 'aspect-[16/9]'}`}>
        <img
          src={data.image}
          alt={data.title}
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    </a>
  )}

  <div class="p-6">
    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {data.tags.slice(0, 2).map(tag => (
          <a
            href={`/blog/tag/${tag}`}
            class="text-xs font-bold uppercase tracking-wide text-primary bg-primary-pale dark:bg-primary/20 dark:text-primary-light px-2 py-0.5 rounded-full hover:bg-primary hover:text-white dark:hover:bg-primary transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}

    <h2 class={`font-black text-gray-900 dark:text-white mb-2 leading-snug group-hover:text-primary dark:group-hover:text-primary-light transition-colors ${featured ? 'text-2xl' : 'text-lg'}`}>
      <a href={`/blog/${slug}`}>{data.title}</a>
    </h2>

    <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">{data.description}</p>

    <div class="flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
      <time datetime={data.pubDate.toISOString()}>{formattedDate}</time>
      <div class="flex items-center gap-3">
        {data.readTime && <span>{data.readTime}</span>}
        <a href={`/blog/${slug}`} class="text-primary dark:text-primary-light font-semibold hover:underline">
          Ler mais →
        </a>
      </div>
    </div>
  </div>
</article>
