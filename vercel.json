{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": true },
    { "source": "/app/(.*)", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
