{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "installCommand": "npm install",
    "rewrites": [
        {
            "source": "/api/sora_down",
            "destination": "/api/sora_down.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        }
    ]
}