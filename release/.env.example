# ============================================================
#  Umbra Hub — Configuração de variáveis de ambiente
#  Renomeie este arquivo para .env e preencha as chaves
#  Coloque o .env na mesma pasta do Umbra Hub.exe
# ============================================================

# ── Supabase (OBRIGATÓRIO) ───────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ── Supadata ─────────────────────────────────────────────────
VITE_SUPADATA_API_KEY=sua_supadata_key_aqui

# ── Gemini AI ────────────────────────────────────────────────
GEMINI_API_KEY=sua_gemini_key_aqui
VITE_GEMINI_API_KEY=sua_gemini_key_aqui

# ── OpenAI (DALL-E / imagens) ────────────────────────────────
OPENAI_API_KEY=sua_openai_key_aqui

# ── Mistral AI ───────────────────────────────────────────────
MISTRAL_API_KEY=sua_mistral_key_aqui

# ── RapidAPI (TikTok analytics fallback) ────────────────────
RAPIDAPI_KEY_1=sua_rapidapi_key_1
RAPIDAPI_KEY_2=sua_rapidapi_key_2
# ... adicione até RAPIDAPI_KEY_15 se necessário

# ── Porta do backend (não altere sem necessidade) ────────────
PORT=3001
