{
  "name": "umbra-hub",
  "productName": "Umbra Hub",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:react": "vite build --outDir dist-react",
    "build:web": "npm install --prefix web && npm run build --prefix web",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/react": "^10.52.0",
    "@supabase/supabase-js": "^2.47.10",
    "@supadata/js": "^1.3.2",
    "@types/jszip": "^3.4.0",
    "@vercel/kv": "^3.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "posthog-js": "^1.372.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  }
}
