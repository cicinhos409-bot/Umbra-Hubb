{
  "manifest_version": 3,
  "name": "Umbra Unified Automation",
  "version": "2.4.0",
  "description": "Automatize prompts no ChatGPT e no Claude com filas, sequências, variáveis, anexos de imagem e links. Uma extensão — duas automações.",
  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://cvrdcupvqvkpwllwlkfw.functions.supabase.co/*"
  ],
  "action": {
    "default_title": "Umbra Unified — abrir painel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
