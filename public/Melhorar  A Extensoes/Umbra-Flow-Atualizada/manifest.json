{
  "manifest_version": 3,
  "name": "Umbra Flow",
  "version": "2.0.0",
  "description": "Automacao completa de videos em lote para Veo 3 Flow + Modo Extend + CDP Click + Grok AI Auto-Fix",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "alarms",
    "sidePanel",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://api.x.ai/*",
    "https://cvrdcupvqvkpwllwlkfw.functions.supabase.co/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://localhost:8765 https://api.x.ai https://cvrdcupvqvkpwllwlkfw.functions.supabase.co"
  },
  "web_accessible_resources": [
    {
      "resources": ["start-server.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "102"
}
